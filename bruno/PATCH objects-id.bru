meta {
  name: PATCH objects/:id
  type: http
  seq: 3
}

patch {
  url: http://localhost:3001/objects/bruno-note
  body: json
  auth: none
}

body:json {
  {
    "x": 240
  }
}

assert {
  res.status: eq 200
  res.body.x: eq 240
}

docs {
  Erwartet: 200, x hat sich von 120 auf 240 geändert.
  Gibt es das Objekt nicht (vorher POST senden), kommt 404.
}
