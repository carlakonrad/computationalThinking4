meta {
  name: POST objects
  type: http
  seq: 2
}

post {
  url: http://localhost:3001/objects
  body: json
  auth: none
}

body:json {
  {
    "id": "bruno-note",
    "type": "sticky-note",
    "x": 120,
    "y": 120,
    "width": 192,
    "height": 192,
    "text": "Aus Bruno",
    "color": "yellow",
    "fontSize": 18,
    "bold": false
  }
}

assert {
  res.status: eq 201
  res.body.id: eq bruno-note
}

docs {
  Erwartet: 201, danach steht das Objekt in backend/data/board.json.
  Ein zweites Mal senden → 409, weil die id schon existiert.
}
